{
  "name": "ZoningRule",
  "type": "object",
  "properties": {
    "city_id": {
      "type": "string",
      "description": "Reference to City entity"
    },
    "city_name": {
      "type": "string",
      "description": "City name for display"
    },
    "zone_code": {
      "type": "string",
      "description": "Zoning code e.g. R-1, R-2, C-1"
    },
    "zone_name": {
      "type": "string",
      "description": "Full zone name e.g. Single Family Residential"
    },
    "use_codes": {
      "type": "string",
      "description": "Comma-separated DOR use codes this rule applies to e.g. 01,02"
    },
    "min_lot_size_sqft": {
      "type": "number",
      "description": "Minimum lot size in square feet"
    },
    "min_lot_width_ft": {
      "type": "number",
      "description": "Minimum lot width in feet"
    },
    "front_setback_ft": {
      "type": "number",
      "description": "Front setback in feet"
    },
    "rear_setback_ft": {
      "type": "number",
      "description": "Rear setback in feet"
    },
    "side_setback_ft": {
      "type": "number",
      "description": "Side setback in feet"
    },
    "max_height_ft": {
      "type": "number",
      "description": "Maximum building height in feet"
    },
    "max_lot_coverage_pct": {
      "type": "number",
      "description": "Maximum lot coverage as percent e.g. 40 for 40%"
    },
    "max_floor_area_ratio": {
      "type": "number",
      "description": "Maximum FAR e.g. 0.5"
    },
    "max_impervious_pct": {
      "type": "number",
      "description": "Maximum impervious surface percent"
    },
    "allowed_uses": {
      "type": "string",
      "description": "Permitted uses description"
    },
    "conditional_uses": {
      "type": "string",
      "description": "Conditional/special uses"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or exceptions"
    }
  },
  "required": [
    "city_id",
    "city_name",
    "zone_code"
  ]
}