{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "description": {
      "type": "string",
      "description": "Project description"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "new_construction",
        "addition",
        "remodel",
        "roofing",
        "electrical",
        "plumbing",
        "pool",
        "fence",
        "demolition",
        "commercial",
        "other"
      ],
      "description": "Type of construction project"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "permitting",
        "in_progress",
        "completed",
        "on_hold"
      ],
      "default": "planning",
      "description": "Current project status"
    },
    "city_id": {
      "type": "string",
      "description": "Reference to City entity"
    },
    "city_name": {
      "type": "string",
      "description": "City name for display"
    },
    "folio_number": {
      "type": "string",
      "description": "BCPA folio number (optional)"
    },
    "property_address": {
      "type": "string",
      "description": "Full property address"
    },
    "estimated_cost": {
      "type": "number",
      "description": "Estimated construction cost in dollars"
    },
    "square_footage": {
      "type": "number",
      "description": "Square footage of the project"
    },
    "notes": {
      "type": "string",
      "description": "Internal project notes"
    },
    "permit_checklist": {
      "type": "string",
      "description": "JSON array of checklist items with label and checked status"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the project owner"
    },
    "is_contractor_project": {
      "type": "boolean",
      "description": "Whether this is managed by a contractor",
      "default": false
    },
    "contractor_license": {
      "type": "string",
      "description": "Contractor license number (contractors only)"
    },
    "client_name": {
      "type": "string",
      "description": "Client name (contractors only)"
    },
    "client_email": {
      "type": "string",
      "description": "Client email (contractors only)"
    }
  },
  "required": [
    "name",
    "project_type",
    "city_name"
  ]
}