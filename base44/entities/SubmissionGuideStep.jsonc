{
  "name": "SubmissionGuideStep",
  "properties": {
    "completed_date": {
      "description": "Date this step was completed",
      "format": "date",
      "type": "string"
    },
    "description": {
      "description": "Instructions shown to the user for this step",
      "type": "string"
    },
    "display_order": {
      "description": "Order this step appears in the guide",
      "type": "number"
    },
    "guide_id": {
      "description": "Reference to SubmissionGuide entity",
      "type": "string"
    },
    "help_text": {
      "description": "Tooltip or additional guidance for this step",
      "type": "string"
    },
    "is_required": {
      "default": true,
      "description": "Whether this step is mandatory",
      "type": "boolean"
    },
    "phase": {
      "description": "Which phase of the journey this step belongs to",
      "enum": [
        "application",
        "preparation",
        "guided_submission"
      ],
      "type": "string"
    },
    "prefilled_value": {
      "description": "Value Open Permit recommends entering in the city portal",
      "type": "string"
    },
    "question_count": {
      "default": 0,
      "description": "Number of questions in this step",
      "type": "number"
    },
    "questions_answered": {
      "default": 0,
      "description": "Number of questions answered in this step",
      "type": "number"
    },
    "section": {
      "description": "Section group this step belongs to e.g. Contractor Info, Site Information",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "description": "Current status of this step",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "skipped",
        "flagged"
      ],
      "type": "string"
    },
    "step_key": {
      "description": "Unique identifier for this step e.g. verify_property, upload_survey, enter_job_value",
      "type": "string"
    },
    "step_type": {
      "description": "Type of action required in this step",
      "enum": [
        "question_set",
        "document_upload",
        "review",
        "portal_entry",
        "confirmation"
      ],
      "type": "string"
    },
    "target_field_label": {
      "description": "Label of the corresponding field in the city portal",
      "type": "string"
    },
    "title": {
      "description": "Short step title shown to user",
      "type": "string"
    },
    "user_notes": {
      "description": "Notes the user can add to this step",
      "type": "string"
    }
  },
  "required": [
    "guide_id",
    "step_key",
    "title",
    "phase",
    "step_type",
    "display_order"
  ],
  "type": "object"
}