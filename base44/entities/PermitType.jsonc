{
  "name": "PermitType",
  "type": "object",
  "properties": {
    "city_id": {
      "type": "string",
      "description": "Reference to city"
    },
    "city_name": {
      "type": "string",
      "description": "City name for display"
    },
    "name": {
      "type": "string",
      "description": "Permit type name"
    },
    "category": {
      "type": "string",
      "enum": [
        "building",
        "electrical",
        "plumbing",
        "fire",
        "certificate",
        "planning",
        "engineering",
        "additional"
      ],
      "description": "Permit category"
    },
    "description": {
      "type": "string",
      "description": "Description of the permit type"
    },
    "typical_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of typical requirements"
    },
    "documents_needed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Documents typically needed"
    },
    "inspections_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Inspections typically required"
    },
    "typical_timeline": {
      "type": "string",
      "description": "Typical processing timeline"
    },
    "map_zone": {
      "type": "string",
      "description": "Which zone on the interactive map this relates to"
    }
  },
  "required": [
    "city_id",
    "name",
    "category"
  ]
}