{
  "name": "PermitStatusLog",
  "type": "object",
  "properties": {
    "permit_number": {
      "type": "string",
      "description": "Municipal permit number"
    },
    "folio_number": {
      "type": "string",
      "description": "BCPA folio number linking to property"
    },
    "project_id": {
      "type": "string",
      "description": "Reference to Project entity"
    },
    "city_id": {
      "type": "string",
      "description": "Reference to City entity"
    },
    "city_name": {
      "type": "string",
      "description": "City name for display"
    },
    "previous_status": {
      "type": "string",
      "enum": [
        "issued",
        "finaled",
        "expired",
        "voided",
        "in_review",
        "pending"
      ],
      "description": "Status before this change"
    },
    "new_status": {
      "type": "string",
      "enum": [
        "issued",
        "finaled",
        "expired",
        "voided",
        "in_review",
        "pending"
      ],
      "description": "Status after this change"
    },
    "changed_by_email": {
      "type": "string",
      "description": "Email of user who made the change"
    },
    "changed_by_name": {
      "type": "string",
      "description": "Display name of user who made the change"
    },
    "changed_by_role": {
      "type": "string",
      "enum": [
        "admin",
        "city_admin",
        "contractor",
        "private_provider",
        "system"
      ],
      "description": "Role of user who triggered the change"
    },
    "change_date": {
      "type": "string",
      "format": "date",
      "description": "Date the status changed"
    },
    "reason": {
      "type": "string",
      "description": "Reason for the status change"
    },
    "notes": {
      "type": "string",
      "description": "Additional context or notes about the change"
    },
    "is_system_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this log entry was created automatically by the system"
    }
  },
  "required": [
    "permit_number",
    "new_status",
    "changed_by_email",
    "change_date"
  ]
}