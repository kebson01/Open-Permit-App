{
  "name": "CitySurcharge",
  "type": "object",
  "properties": {
    "city_id": {
      "type": "string",
      "description": "Reference to city"
    },
    "city_name": {
      "type": "string",
      "description": "City name for display"
    },
    "effective_date": {
      "type": "string",
      "description": "Fee schedule effective date e.g. October 1, 2025"
    },
    "resolution": {
      "type": "string",
      "description": "Resolution number e.g. 2026-07"
    },
    "technology_admin": {
      "type": "number",
      "description": "Technology & administration fee per permit"
    },
    "board_of_rules_rate": {
      "type": "number",
      "description": "Board of rules rate per $1,000 construction cost"
    },
    "educational_rate": {
      "type": "number",
      "description": "Educational fee as decimal e.g. 0.0003"
    },
    "dca_rate": {
      "type": "number",
      "description": "DCA surcharge rate as decimal e.g. 0.01"
    },
    "dbpr_rate": {
      "type": "number",
      "description": "DBPR fee rate as decimal e.g. 0.015"
    }
  },
  "required": [
    "city_id",
    "city_name"
  ]
}