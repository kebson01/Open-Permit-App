{
  "name": "SubmissionDocument",
  "properties": {
    "city_system_field": {
      "description": "Where to attach this document in the city portal",
      "type": "string"
    },
    "description": {
      "description": "What the document needs to contain",
      "type": "string"
    },
    "document_type": {
      "description": "Type of document",
      "enum": [
        "site_plan",
        "survey",
        "contractor_license",
        "insurance_certificate",
        "product_approval",
        "energy_calc",
        "noa",
        "drawings",
        "photos",
        "hoa_approval",
        "notarized_form",
        "other"
      ],
      "type": "string"
    },
    "file_url": {
      "description": "URL to the uploaded document",
      "type": "string"
    },
    "guide_id": {
      "description": "Reference to SubmissionGuide entity",
      "type": "string"
    },
    "is_required": {
      "default": true,
      "description": "Whether this document is mandatory for submission",
      "type": "boolean"
    },
    "label": {
      "description": "Display name of the document e.g. Signed Survey, NOA - Impact Windows",
      "type": "string"
    },
    "notes": {
      "description": "Additional notes or requirements for this document",
      "type": "string"
    },
    "status": {
      "default": "not_started",
      "description": "Current status of this document",
      "enum": [
        "not_started",
        "pending",
        "uploaded",
        "submitted",
        "approved",
        "rejected"
      ],
      "type": "string"
    },
    "upload_date": {
      "description": "Date the document was uploaded",
      "format": "date",
      "type": "string"
    },
    "uploaded_by": {
      "description": "Email of user who uploaded the document",
      "type": "string"
    }
  },
  "required": [
    "guide_id",
    "document_type",
    "label",
    "is_required"
  ],
  "type": "object"
}