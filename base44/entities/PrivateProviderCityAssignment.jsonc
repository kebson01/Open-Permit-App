{
  "name": "PrivateProviderCityAssignment",
  "properties": {
    "assigned_by": {
      "description": "Email of admin who approved the assignment",
      "type": "string"
    },
    "assignment_date": {
      "description": "Date the assignment was approved",
      "format": "date",
      "type": "string"
    },
    "city_id": {
      "description": "Reference to City entity",
      "type": "string"
    },
    "city_name": {
      "description": "City name for display",
      "type": "string"
    },
    "firm_id": {
      "description": "Reference to PrivateProviderFirm entity",
      "type": "string"
    },
    "firm_name": {
      "description": "Firm name for display",
      "type": "string"
    },
    "services_authorized": {
      "description": "Services this firm is authorized to perform in this city",
      "items": {
        "enum": [
          "plan_review",
          "inspections",
          "threshold_inspections",
          "fire_review",
          "structural_review"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "default": "active",
      "description": "Assignment status",
      "enum": [
        "active",
        "inactive",
        "pending_approval"
      ],
      "type": "string"
    }
  },
  "required": [
    "firm_id",
    "city_id",
    "city_name",
    "firm_name"
  ],
  "type": "object"
}