{
  "name": "OnboardingStep",
  "properties": {
    "action_label": {
      "description": "Label for the CTA button e.g. 'Search My Property'",
      "type": "string"
    },
    "action_route": {
      "description": "App route or screen to navigate to for this step",
      "type": "string"
    },
    "description": {
      "description": "Explanation shown to the user for this step",
      "type": "string"
    },
    "display_order": {
      "description": "Order this step appears in the onboarding flow",
      "type": "number"
    },
    "icon": {
      "description": "Icon name for visual display e.g. 'home', 'file', 'search'",
      "type": "string"
    },
    "is_required": {
      "default": true,
      "description": "Whether this step is required or can be skipped",
      "type": "boolean"
    },
    "role": {
      "description": "Which user role this step applies to",
      "enum": [
        "homeowner",
        "contractor",
        "private_provider",
        "city_admin"
      ],
      "type": "string"
    },
    "step_key": {
      "description": "Unique identifier for this step e.g. 'add_property', 'complete_profile'",
      "type": "string"
    },
    "title": {
      "description": "Short step title shown in progress indicator",
      "type": "string"
    }
  },
  "required": [
    "role",
    "step_key",
    "title",
    "display_order"
  ],
  "type": "object"
}