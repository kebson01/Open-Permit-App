{
  "name": "UserOnboarding",
  "properties": {
    "city_id": {
      "description": "City selected during onboarding (if applicable)",
      "type": "string"
    },
    "city_name": {
      "description": "City name selected during onboarding",
      "type": "string"
    },
    "completed_date": {
      "description": "Date onboarding was fully completed",
      "format": "date",
      "type": "string"
    },
    "current_step": {
      "description": "Key of the step the user is currently on",
      "type": "string"
    },
    "is_complete": {
      "default": false,
      "description": "Whether the user has finished onboarding",
      "type": "boolean"
    },
    "is_skipped": {
      "default": false,
      "description": "Whether the user chose to skip onboarding",
      "type": "boolean"
    },
    "role": {
      "description": "Role being onboarded",
      "enum": [
        "homeowner",
        "contractor",
        "private_provider",
        "city_admin"
      ],
      "type": "string"
    },
    "started_date": {
      "description": "Date onboarding was started",
      "format": "date",
      "type": "string"
    },
    "steps_completed": {
      "description": "JSON array of completed step keys e.g. ['verify_email','add_property']",
      "type": "string"
    },
    "steps_skipped": {
      "description": "JSON array of skipped step keys",
      "type": "string"
    },
    "user_email": {
      "description": "Email of the user being onboarded",
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "role"
  ],
  "type": "object"
}