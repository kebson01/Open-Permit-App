{
  "name": "City",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "City name"
    },
    "state": {
      "type": "string",
      "description": "State name"
    },
    "county": {
      "type": "string",
      "description": "County name"
    },
    "slug": {
      "type": "string",
      "description": "Unique URL-friendly identifier for city portal (e.g. 'weston', 'coral-springs')"
    },
    "enabled_services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "permit_guide",
          "fee_calculator"
        ]
      },
      "description": "Which services are enabled for this city's public portal"
    },
    "portal_url": {
      "type": "string",
      "description": "URL to city's permit portal"
    },
    "fee_schedule_effective_date": {
      "type": "string",
      "format": "date",
      "description": "When the fee schedule became effective"
    },
    "building_department_phone": {
      "type": "string",
      "description": "Building department phone number"
    },
    "building_department_address": {
      "type": "string",
      "description": "Building department address"
    }
  },
  "required": [
    "name",
    "state",
    "county"
  ]
}