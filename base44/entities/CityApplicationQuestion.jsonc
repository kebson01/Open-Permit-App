{
  "name": "CityApplicationQuestion",
  "type": "object",
  "properties": {
    "city_id": {
      "type": "string",
      "description": "Reference to City entity"
    },
    "city_name": {
      "type": "string",
      "description": "City name for display"
    },
    "permit_type_id": {
      "type": "string",
      "description": "Reference to PermitType entity"
    },
    "permit_type_name": {
      "type": "string",
      "description": "Permit type name for display"
    },
    "target_system": {
      "type": "string",
      "enum": [
        "accela",
        "tyler_energov",
        "tyler_munis",
        "oracle",
        "easy_permit",
        "manual",
        "other"
      ],
      "description": "City permit system this question maps to"
    },
    "section": {
      "type": "string",
      "description": "Question group label e.g. Project Details, Contractor Info, Site Information"
    },
    "question_key": {
      "type": "string",
      "description": "Unique key for this question e.g. job_valuation, is_hoa_property, pool_depth_ft"
    },
    "question_text": {
      "type": "string",
      "description": "The question exactly as shown to the user"
    },
    "help_text": {
      "type": "string",
      "description": "Tooltip or clarification text for the user"
    },
    "input_type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "boolean",
        "select",
        "multi_select",
        "date",
        "file",
        "address"
      ],
      "description": "Type of input field"
    },
    "options": {
      "type": "string",
      "description": "JSON array of choices for select or multi_select types"
    },
    "is_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether this question must be answered"
    },
    "display_order": {
      "type": "number",
      "description": "Order the question appears within its section"
    },
    "conditional_on_key": {
      "type": "string",
      "description": "question_key of another question that controls visibility of this one"
    },
    "conditional_on_value": {
      "type": "string",
      "description": "The answer value that triggers this question to appear"
    },
    "target_system_field": {
      "type": "string",
      "description": "Exact field name in the city system e.g. JOB_VALUE in Accela"
    },
    "target_system_section": {
      "type": "string",
      "description": "Which section of the city portal this field belongs to"
    },
    "prefill_from": {
      "type": "string",
      "description": "Open Permit source field to auto-answer e.g. project.estimated_cost, property.BLDG_TOT_SQ_FOOTAGE, contractor.license_number"
    },
    "validation_rule": {
      "type": "string",
      "description": "Validation rule e.g. min:0, max:999999, regex pattern"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this question is currently in use"
    }
  },
  "required": [
    "city_id",
    "city_name",
    "permit_type_name",
    "question_key",
    "question_text",
    "input_type"
  ]
}