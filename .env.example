# Supabase project the app talks to (database, auth, Edge Functions).
# Optional: when unset, the app falls back to the production project baked
# into src/lib/supabase.js. Set these to point local dev or a preview build
# at a staging project. Copy to `.env.local` and fill in.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional (prototype): enable SAM segmentation to refine AI Smart Check photo
# zones into pixel-accurate "molded" masks. Requires the `segment-zones` Edge
# Function deployed with a REPLICATE_API_TOKEN (and REPLICATE_SAM_VERSION)
# secret set on the Supabase project. Off by default.
VITE_USE_SAM=false
