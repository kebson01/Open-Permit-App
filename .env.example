# Supabase project the app talks to (database, auth, Edge Functions).
# Optional: when unset, the app falls back to the production project baked
# into src/lib/supabase.js. Set these to point local dev or a preview build
# at a staging project. Copy to `.env.local` and fill in.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional (prototype): enable object grounding to place AI Smart Check photo
# markers on the real detected object instead of an LLM-estimated point.
# Requires the `ground-objects` Edge Function deployed with REPLICATE_API_TOKEN
# and REPLICATE_GROUNDING_VERSION secrets on the Supabase project. Off by default.
VITE_USE_GROUNDING=false
